{
  "name": "codegen-engine",
  "version": "0.0.4",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p example",
    "prepublishOnly": "npm run typecheck && npm run build",
    "example": "tsx --tsconfig example/tsconfig.json example/cge/src/generate.ts",
    "example:uml": "tsx --tsconfig example/tsconfig.json example/cge/src/uml/serve.ts"
  },
  "keywords": [],
  "author": "John Cruickshank",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@typescript/native-preview": "^7.0.0-dev.20260328.1",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
